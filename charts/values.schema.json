{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "namespace"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 }
          }
        },
        "projectSlug": { "type": "string" }
      }
    },
    "externalRegistrySecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "environmentSlug", "secretPath", "url", "usernameKey", "passwordKey"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "environmentSlug": { "type": "string", "minLength": 1 },
          "secretPath": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "usernameKey": { "type": "string", "minLength": 1 },
          "passwordKey": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["helm", "git"], "default": "helm" },
          "enableOCI": { "type": "boolean" }
        }
      }
    }
  }
}
